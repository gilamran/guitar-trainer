{
  "name": "guitar-trainer",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-based guitar practice app: load Guitar Pro / MusicXML, loop sections, get real-time mic feedback.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gilamran/guitar-trainer.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.8.4",
    "pitchy": "^4.1.0"
  },
  "devDependencies": {
    "@coderline/alphatab-vite": "^1.8.4",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
